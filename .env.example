# Supabase configuration template.
# Copy this file to ".env" (no .example suffix) and fill in YOUR project's values.
# Find these at: Supabase dashboard → Project Settings → API
#
# IMPORTANT:
# - The .env file is in .gitignore so your values are NOT committed publicly.
# - For Vercel deployment, set these same two variables in:
#   Project Settings → Environment Variables (production, preview, and development).
# - Without a .env file, the app falls back to localStorage-only (no auth, no cloud sync).

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=sb_publishable_your_publishable_key_here
